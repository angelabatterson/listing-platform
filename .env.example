# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://lp:lp@localhost:5432/listing

# Public URL of the app, no trailing slash
APP_URL=http://localhost:3000

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts marketplace tokens at rest. Never change it once real stores are connected.
ENCRYPTION_KEY=

# eBay developer keys (developer.ebay.com > Application Keys)
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The "RuName" (eBay Redirect URL name) from User Tokens > Get a Token from eBay via Your Application.
# Its "auth accepted URL" must be ${APP_URL}/api/ebay/oauth/callback
EBAY_RUNAME=

# Marketplace account deletion notifications (required for production keys).
# Any 32-80 char string of letters, digits, _ and -. Enter the same value in the eBay portal.
EBAY_DELETION_VERIFICATION_TOKEN=
# Must exactly match the endpoint URL entered in the eBay portal.
EBAY_DELETION_ENDPOINT_URL=http://localhost:3000/api/ebay/account-deletion

# Etsy developer keys (etsy.com/developers > Your apps). The callback URL registered
# with Etsy must be ${APP_URL}/api/etsy/oauth/callback
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Signing secret from Etsy's Webhook portal (starts with whsec_), for the order.paid
# webhook at ${APP_URL}/api/etsy/webhook
ETSY_WEBHOOK_SECRET=

# Protects the scheduled sales check at /api/cron/check-sales. Any long random string.
CRON_SECRET=

# Anthropic API key for the AI listing assistant (console.anthropic.com > API keys).
# Without it, photo batches still work but listings aren't written automatically.
ANTHROPIC_API_KEY=
